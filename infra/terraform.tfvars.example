# Public example only. Real account/project mapping belongs outside this checkout.
backend_project_id               = "your-backend-project"
firebase_project_id              = "your-firebase-project"
region                           = "asia-south1"
provision_backend_infrastructure = false
deploy_backend                   = false
backend_image                    = ""
frontend_origins                  = []
gemini_model                      = ""
