{
  "name": "vibeestimate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:connected": "node scripts/dev-connected.mjs",
    "build": "npm run build --workspaces --if-present",
    "terraform:production": "node --experimental-strip-types scripts/terraform-production.mts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @vibeestimate/backend",
    "test:rules": "node scripts/rules.mjs",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:local": "node scripts/test-local.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:connected": "node tests/live/run-connected.mjs",
    "test:config": "node --test tests/local-env.test.mjs tests/emulator-auth-continuity.test.mjs tests/connected-config.test.mjs tests/production-verification-env.test.mjs",
    "mcp:playwright": "node scripts/start-playwright-mcp.mjs",
    "mcp:verify": "node scripts/verify-mcp.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:design": "node .agents/skills/impeccable/scripts/detect.mjs --json frontend/src",
    "check:infra": "node infra/scripts/check.mjs",
    "test:spatial": "tsx --test tests/spatial/*.test.ts",
    "build:spatial": "npm run build --workspace @vibeestimate/frontend",
    "start:spatial": "node scripts/v1-preview.mjs start",
    "test:spatial:browser": "node scripts/v1-preview.mjs test",
    "review:spatial": "node scripts/v1-preview.mjs review",
    "setup:spatial:browser": "node scripts/spatial-preview.mjs install",
    "assets:spatial": "node scripts/spatial-models.mjs",
    "verify:spatial": "node scripts/verify-v1.mjs",
    "build:scene": "npm run build --workspace @vibeestimate/scene-schema && npm run build --workspace @vibeestimate/scene-core",
    "pretypecheck": "npm run build:scene",
    "prebuild": "npm run build:scene",
    "prebuild:spatial": "npm run build:scene",
    "start:v1": "node scripts/v1-preview.mjs start",
    "test:v1:browser": "node scripts/v1-preview.mjs test",
    "review:v1": "node scripts/v1-preview.mjs review",
    "test:v1:config": "node --test tests/v1/env.test.mjs tests/v1/startup.test.mjs tests/live/v1-target.test.mjs",
    "verify:v1": "node scripts/verify-v1.mjs",
    "test:v1:scene": "tsx --test tests/v1/design-core.test.ts",
    "assets:homes": "node scripts/spatial-home-previews.mjs",
    "test:v1:production": "node scripts/verify-v1-production.mjs",
    "test:v1:container": "node scripts/verify-v1-container.mjs",
    "typecheck:v1": "tsc -p tests/v1/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.63.0",
    "@types/three": "0.185.0",
    "esbuild": "0.25.12",
    "firebase-tools": "15.29.0",
    "jsqr": "1.4.0",
    "three": "0.185.0",
    "tsx": "4.20.6",
    "vitest": "3.2.6"
  }
}
