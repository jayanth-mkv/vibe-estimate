# Backend build context is an allowlist; local tools, emulator records,
# browser traces, private environment files, and Terraform state stay out.
**
!package.json
!package-lock.json
!frontend/
!frontend/package.json
!frontend/tsconfig.json
!frontend/next.config.ts
!frontend/postcss.config.mjs
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
!backend/package.json
!backend/tsconfig.json
!backend/src/
!backend/src/**
!packages/
!packages/*/
!packages/*/package.json
!packages/*/tsconfig.json
!packages/*/src/
!packages/*/src/**
!scripts/
!scripts/start-production.mjs
!Dockerfile
**/node_modules
**/.next
**/dist
**/.cache
**/*.tsbuildinfo
**/.env*
